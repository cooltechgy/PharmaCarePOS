@page "/customers"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>Customers - PharmaCare POS</PageTitle>
<div class="page-heading"><div><h1>Customers</h1><p>Customer and patient directory.</p></div></div>
<div class="toolbar page-card compact"><button class="btn btn-primary" @onclick="New">+ New Customer</button><button class="btn btn-light" disabled="@(selected is null)" @onclick="Edit">Edit</button><input class="search-input right" @bind="search" @bind:event="oninput" placeholder="Search customers..." /></div>
@if(showForm){
<div class="page-card form-card modal-inline">
<h3>@(editId is null?"New Customer":"Edit Customer")</h3>
<div class="form-grid"><label>Name<input @bind="form.Name"/></label><label>Phone<input @bind="form.Phone"/></label><label>Email<input @bind="form.Email"/></label><label>Address<input @bind="form.Address"/></label><label>Allergies<input @bind="form.Allergies"/></label><label>Medical Conditions<input @bind="form.MedicalConditions"/></label></div>
<div class="form-actions"><button class="btn btn-primary" @onclick="SaveAsync">Save</button><button class="btn btn-light" @onclick="()=>showForm=false">Cancel</button></div>
</div>}
<div class="page-card table-card"><div class="table-wrap"><table>
<thead><tr><th>ID</th><th>Name</th><th>Phone</th><th>Email</th><th>Allergies</th></tr></thead>
<tbody>@foreach(var x in Filtered){<tr class="@(selected?.Id==x.Id?"selected":"")" @onclick="()=>selected=x"><td>C@(x.Id.ToString("D3"))</td><td><strong>@x.Name</strong></td><td>@x.Phone</td><td>@x.Email</td><td>@x.Allergies</td></tr>}</tbody>
</table></div></div>
@code{
private List<CustomerDto> rows=[];private CustomerDto? selected;private CustomerRequest form=new();private int? editId;private bool showForm;private string search="";
private IEnumerable<CustomerDto> Filtered=>rows.Where(x=>string.IsNullOrWhiteSpace(search)||x.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Phone.Contains(search,StringComparison.OrdinalIgnoreCase));
protected override Task OnInitializedAsync()=>LoadAsync();
private async Task LoadAsync(){if(Session.Current is not null)rows=await Api.CustomersAsync(Session.Current.TenantId);}
private void New(){editId=null;form=new CustomerRequest{TenantId=Session.Current?.TenantId??0};showForm=true;}
private void Edit(){if(selected is null)return;editId=selected.Id;form=new CustomerRequest{Id=selected.Id,TenantId=selected.TenantId,Name=selected.Name,Phone=selected.Phone,Email=selected.Email,Address=selected.Address,Allergies=selected.Allergies,MedicalConditions=selected.MedicalConditions,CurrentMedications=selected.CurrentMedications,Notes=selected.Notes};showForm=true;}
private async Task SaveAsync(){await Api.SaveCustomerAsync(form,editId);showForm=false;await LoadAsync();}
}
