@page "/reports"
@inject ApiClient Api
@inject SessionState Session
<PageTitle>Reports - PharmaCare POS</PageTitle>
<div class="page-heading"><div><h1>Reports</h1><p>Recent sales and revenue from the existing API.</p></div></div>
<div class="stats-grid">
<div class="stat-card green"><span class="stat-icon">$</span><div><small>Revenue</small><strong>@Revenue.ToString("C")</strong></div></div>
<div class="stat-card blue"><span class="stat-icon">▣</span><div><small>Invoices</small><strong>@report.Sales.Count</strong></div></div>
<div class="stat-card orange"><span class="stat-icon">#</span><div><small>Units Sold</small><strong>@Units</strong></div></div>
</div>
<div class="page-card table-card"><div class="table-wrap"><table><thead><tr><th>Date</th><th>Invoice</th><th>Total</th><th>Payment</th></tr></thead><tbody>
@foreach(var x in report.Sales){<tr><td>@x.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><strong>@x.InvoiceNo</strong></td><td>@x.Total.ToString("C")</td><td>@x.PaymentMethod</td></tr>}
</tbody></table></div></div>
@code{
private SalesReportDto report=new();private decimal Revenue=>report.Sales.Sum(x=>x.Total);private decimal Units=>report.Lines.Sum(x=>x.Quantity);
protected override async Task OnInitializedAsync(){if(Session.Current is not null)report=await Api.SalesReportAsync(Session.Current)??new();}
}
