<Application x:Class="PharmaCarePOS.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="NavyBrush" Color="#0B4368"/>
  <SolidColorBrush x:Key="BlueBrush" Color="#087FF5"/>
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#D7E6F1"/>
  <SolidColorBrush x:Key="TextBrush" Color="#0B2447"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#607A97"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#F4F9FD"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="{StaticResource BlueBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/></Style>
  <Style x:Key="GreenButton" TargetType="Button"><Setter Property="Background" Value="#16B867"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#16B867"/></Style>
  <Style x:Key="OrangeButton" TargetType="Button"><Setter Property="Background" Value="#FFC344"/><Setter Property="Foreground" Value="#0B2447"/><Setter Property="BorderBrush" Value="#FFC344"/></Style>
  <Style x:Key="DangerButton" TargetType="Button"><Setter Property="Background" Value="#FF4051"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF4051"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="3"/><Setter Property="BorderBrush" Value="#BFD5E6"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="3"/><Setter Property="BorderBrush" Value="#BFD5E6"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/><Setter Property="RowHeight" Value="34"/><Setter Property="ColumnHeaderHeight" Value="34"/></Style>
 </Application.Resources>
</Application>
