<UserControl x:Class="PharmaCarePOS.Desktop.Views.ProductsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <Grid Margin="0,0,0,14">
   <StackPanel>
    <TextBlock Text="Products" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="Manage your medicine catalogue and pricing." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
   </StackPanel>
  </Grid>

  <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,12">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Button Content="+ Add Product" Style="{StaticResource PrimaryButton}" IsEnabled="False" ToolTip="Product editing will be connected to the API in a later build"/>
    <Button Grid.Column="1" Content="Edit" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
    <Button Grid.Column="2" Content="Delete" Style="{StaticResource DangerButton}" IsEnabled="False"/>
    <Border Grid.Column="3" HorizontalAlignment="Right" Width="340" Height="38" BorderBrush="#C9D9E6" BorderThickness="1" CornerRadius="7">
     <Grid>
      <TextBlock Text="⌕" FontSize="18" Foreground="#71889A" Margin="10,0,0,0" VerticalAlignment="Center"/>
      <TextBox x:Name="SearchBox" Margin="32,0,0,0" BorderThickness="0" Background="Transparent"
               TextChanged="SearchBox_TextChanged" ToolTip="Search products"/>
     </Grid>
    </Border>
   </Grid>
  </Border>

  <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
   <DataGrid x:Name="Grid">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="2*"/>
     <DataGridTextColumn Header="Generic" Binding="{Binding GenericName}" Width="1.5*"/>
     <DataGridTextColumn Header="Strength" Binding="{Binding Strength}" Width="*"/>
     <DataGridTextColumn Header="Form" Binding="{Binding DosageForm}" Width="*"/>
     <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.15*"/>
     <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="1.35*"/>
     <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=C}" Width="*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
 </Grid>
</UserControl>