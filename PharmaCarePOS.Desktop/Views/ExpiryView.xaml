<UserControl x:Class="PharmaCarePOS.Desktop.Views.ExpiryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="Expiry Stock" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="Medicines expiring within the next 90 days." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
  </StackPanel>

  <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,12">
   <Grid>
    <ComboBox Width="170" HorizontalAlignment="Left" SelectedIndex="0">
     <ComboBoxItem Content="Next 3 Months"/>
    </ComboBox>
    <Border HorizontalAlignment="Right" Width="330" Height="38" BorderBrush="#C9D9E6" BorderThickness="1" CornerRadius="7">
     <Grid>
      <TextBlock Text="⌕" FontSize="18" Foreground="#71889A" Margin="10,0,0,0" VerticalAlignment="Center"/>
      <TextBox Margin="32,0,0,0" BorderThickness="0" Background="Transparent" ToolTip="Search expiring products"/>
     </Grid>
    </Border>
   </Grid>
  </Border>

  <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
   <DataGrid x:Name="Grid">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Batch No." Binding="{Binding BatchNo}" Width="1.2*"/>
     <DataGridTextColumn Header="Product ID" Binding="{Binding ProductId}" Width="*"/>
     <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat=d}" Width="1.3*"/>
     <DataGridTextColumn Header="Current Stock" Binding="{Binding Quantity}" Width="*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
 </Grid>
</UserControl>