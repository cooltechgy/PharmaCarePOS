<UserControl x:Class="PharmaCarePOS.Desktop.Views.StockView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="Stock Management" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="Review current batch quantities, expiry dates and selling prices." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
  </StackPanel>

  <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,12">
   <Grid>
    <StackPanel Orientation="Horizontal">
     <ComboBox Width="150" SelectedIndex="0">
      <ComboBoxItem Content="All Categories"/>
     </ComboBox>
     <ComboBox Width="150" SelectedIndex="0">
      <ComboBoxItem Content="All Batches"/>
     </ComboBox>
     <CheckBox Content="Low stock only" VerticalAlignment="Center" Margin="10,0"/>
    </StackPanel>
    <Border HorizontalAlignment="Right" Width="300" Height="38" BorderBrush="#C9D9E6" BorderThickness="1" CornerRadius="7">
     <Grid>
      <TextBlock Text="⌕" FontSize="18" Foreground="#71889A" Margin="10,0,0,0" VerticalAlignment="Center"/>
      <TextBox Margin="32,0,0,0" BorderThickness="0" Background="Transparent" ToolTip="Search stock"/>
     </Grid>
    </Border>
   </Grid>
  </Border>

  <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
   <DataGrid x:Name="Grid">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="1.1*"/>
     <DataGridTextColumn Header="Product ID" Binding="{Binding ProductId}" Width="*"/>
     <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=d}" Width="1.2*"/>
     <DataGridTextColumn Header="Current Stock" Binding="{Binding Quantity}" Width="*"/>
     <DataGridTextColumn Header="Unit Cost" Binding="{Binding PurchasePrice, StringFormat=C}" Width="*"/>
     <DataGridTextColumn Header="Selling Price" Binding="{Binding SellingPrice, StringFormat=C}" Width="*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
 </Grid>
</UserControl>