<UserControl x:Class="PharmaCarePOS.Desktop.Views.PosView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="POS Sales – Desktop" FontSize="26" FontWeight="Bold"/><TextBlock Text="API-first sale workflow with SQLite offline queue." Foreground="{StaticResource MutedBrush}"/></StackPanel>
   <TextBlock x:Name="ModeText" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.18*"/><ColumnDefinition Width=".82*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,7,0">
    <Grid Margin="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Height="42" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" ToolTip="Scan barcode or search medicine"/>
      <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click"/>
     </Grid>
     <DataGrid x:Name="ProductsGrid" Grid.Row="1" Margin="0,10,0,0" MouseDoubleClick="ProductsGrid_MouseDoubleClick">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="Generic" Binding="{Binding GenericName}" Width="1.6*"/>
       <DataGridTextColumn Header="Strength" Binding="{Binding Strength}" Width="*"/>
       <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="1.3*"/>
       <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=C}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="7,0,0,0">
    <Grid Margin="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="Cart" FontSize="20" FontWeight="Bold"/><Button Content="Clear" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Click="ClearCart_Click"/></Grid>
     <DataGrid x:Name="CartGrid" Grid.Row="1" Margin="0,10,0,0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*"/>
       <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="*"/>
       <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
       <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="90"/>
       <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=C}" Width="95"/>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="2" Margin="0,12">
      <Grid><TextBlock Text="Subtotal" FontSize="16"/><TextBlock x:Name="SubtotalText" Text="$0.00" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
      <Grid Margin="0,8,0,0" Background="#EAF4FF"><TextBlock Text="Total" FontSize="21" FontWeight="Bold" Margin="8"/><TextBlock x:Name="TotalText" Text="$0.00" FontSize="21" FontWeight="Bold" Foreground="#075BCB" HorizontalAlignment="Right" Margin="8"/></Grid>
     </StackPanel>
     <UniformGrid Grid.Row="3" Columns="2">
      <Button Content="Pay Here" Style="{StaticResource GreenButton}" Height="52" Click="PayHere_Click"/>
      <Button Content="Send to Cashier" Style="{StaticResource OrangeButton}" Height="52" Click="SendCashier_Click"/>
     </UniformGrid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
