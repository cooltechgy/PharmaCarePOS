<UserControl x:Class="PharmaCarePOS.Desktop.Views.PosView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <Grid Margin="0,0,0,14">
   <StackPanel>
    <TextBlock Text="POS Sales" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="Search or scan medicines, then double-click an item to add it to the cart." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
   </StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EAF4FF" CornerRadius="8" Padding="11,7">
    <TextBlock x:Name="ModeText" Foreground="#0B6FD3" FontWeight="SemiBold"/>
   </Border>
  </Grid>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.7*"/>
    <ColumnDefinition Width=".78*"/>
   </Grid.ColumnDefinitions>

   <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <Grid>
      <TextBlock Text="Product Search" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Double-click to add" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
     </Grid>

     <Grid Grid.Row="1" Margin="0,12,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Height="42" BorderBrush="#C9D9E6" BorderThickness="1" CornerRadius="7">
       <Grid>
        <TextBlock Text="⌕" FontSize="19" Foreground="#71889A" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="SearchBox" Margin="32,0,0,0" BorderThickness="0" Background="Transparent"
                 TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                 ToolTip="Scan barcode or search medicine"/>
       </Grid>
      </Border>
      <Button Grid.Column="1" Content="Refresh" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Refresh_Click"/>
     </Grid>

     <DataGrid x:Name="ProductsGrid" Grid.Row="2" MouseDoubleClick="ProductsGrid_MouseDoubleClick">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="Generic" Binding="{Binding GenericName}" Width="1.45*"/>
       <DataGridTextColumn Header="Strength" Binding="{Binding Strength}" Width="*"/>
       <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="1.25*"/>
       <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=C}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>

   <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <Grid>
      <TextBlock Text="Cart" Style="{StaticResource SectionTitle}"/>
      <Button Content="Clear Cart" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Padding="10,5" Click="ClearCart_Click"/>
     </Grid>

     <DataGrid x:Name="CartGrid" Grid.Row="1" Margin="0,12,0,0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*"/>
       <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="55"/>
       <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="78"/>
       <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=C}" Width="82"/>
      </DataGrid.Columns>
     </DataGrid>

     <StackPanel Grid.Row="2" Margin="0,14,0,12">
      <Grid Margin="3,3">
       <TextBlock Text="Subtotal" Foreground="{StaticResource MutedBrush}"/>
       <TextBlock x:Name="SubtotalText" Text="$0.00" FontWeight="SemiBold" HorizontalAlignment="Right"/>
      </Grid>
      <Border Background="#EAF4FF" CornerRadius="7" Padding="10" Margin="0,8,0,0">
       <Grid>
        <TextBlock Text="Total" FontSize="18" FontWeight="Bold"/>
        <TextBlock x:Name="TotalText" Text="$0.00" FontSize="20" FontWeight="Bold" Foreground="#075BCB" HorizontalAlignment="Right"/>
       </Grid>
      </Border>
     </StackPanel>

     <StackPanel Grid.Row="3">
      <Button Content="Pay Here" Style="{StaticResource GreenButton}" Height="46" Margin="0,0,0,6" Click="PayHere_Click"/>
      <Button Content="Send to Cashier" Style="{StaticResource OrangeButton}" Height="42" Margin="0" Click="SendCashier_Click"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>