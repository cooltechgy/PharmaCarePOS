<Window x:Class="PharmaCarePOS.Desktop.Views.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PharmaCare POS - Login" Width="900" Height="560"
 WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions>
  <Border Background="#1594E9">
   <StackPanel VerticalAlignment="Center" Margin="50">
    <Border Width="84" Height="84" CornerRadius="18" Background="White" HorizontalAlignment="Left">
     <TextBlock Text="✚" FontSize="55" Foreground="#0FAE67" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <TextBlock Text="PharmaCare POS" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,22,0,8"/>
    <TextBlock Text="Desktop Application" Foreground="#E8F7FF" FontSize="18"/>
    <TextBlock Text="Fast • Reliable • Offline-ready" Foreground="White" FontSize="16" Margin="0,28,0,0"/>
   </StackPanel>
  </Border>
  <StackPanel Grid.Column="1" Margin="42" VerticalAlignment="Center">
   <TextBlock Text="Welcome Back" FontSize="28" FontWeight="Bold"/>
   <TextBlock Text="Sign in to your pharmacy workspace." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,24"/>
   <TextBlock Text="Username" FontWeight="SemiBold"/>
   <TextBox x:Name="UsernameBox" Text="admin" Margin="0,6,0,14"/>
   <TextBlock Text="Password" FontWeight="SemiBold"/>
   <PasswordBox x:Name="PasswordBox" Password="Admin123!" Margin="0,6,0,10"/>
   <TextBlock x:Name="StatusText" Foreground="#A84444" TextWrapping="Wrap" Margin="0,5,0,10"/>
   <Button x:Name="LoginButton" Content="Login" Style="{StaticResource PrimaryButton}" Height="44" Click="LoginButton_Click"/>
   <TextBlock Text="v7.7 Desktop • API + SQLite offline mode" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
  </StackPanel>
 </Grid>
</Window>
