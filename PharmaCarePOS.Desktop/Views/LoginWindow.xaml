<Window x:Class="PharmaCarePOS.Desktop.Views.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PharmaCare POS - Login" Width="960" Height="590"
 WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
 Background="#EFF6FC">
 <Grid Margin="18">
  <Border CornerRadius="16" Background="White" BorderBrush="#D8E6F1" BorderThickness="1">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="0.95*"/>
     <ColumnDefinition Width="1.05*"/>
    </Grid.ColumnDefinitions>

    <Border CornerRadius="16,0,0,16">
     <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
       <GradientStop Color="#0E8FF5" Offset="0"/>
       <GradientStop Color="#0877D9" Offset="0.58"/>
       <GradientStop Color="#0B5EAE" Offset="1"/>
      </LinearGradientBrush>
     </Border.Background>
     <Grid Margin="46,40">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
       <Border Width="58" Height="58" CornerRadius="14" Background="White">
        <TextBlock Text="✚" FontSize="38" FontWeight="Bold" Foreground="#16B867" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <StackPanel Margin="14,5,0,0">
        <TextBlock Text="PharmaCare POS" Foreground="White" FontSize="25" FontWeight="Bold"/>
        <TextBlock Text="Pharmacy Management System" Foreground="#D9F0FF" FontSize="13"/>
       </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="1" VerticalAlignment="Center">
       <TextBlock Text="Fast • Reliable • Secure" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Text="Everything your pharmacy needs in one desktop workspace." Foreground="#E8F6FF" FontSize="14" TextWrapping="Wrap" Margin="0,8,30,24"/>
       <StackPanel>
        <TextBlock Text="✓  Fast &amp; Reliable" Foreground="White" FontSize="14" Margin="0,6"/>
        <TextBlock Text="✓  Secure &amp; Compliant" Foreground="White" FontSize="14" Margin="0,6"/>
        <TextBlock Text="✓  Offline-ready selling" Foreground="White" FontSize="14" Margin="0,6"/>
        <TextBlock Text="✓  Easy inventory control" Foreground="White" FontSize="14" Margin="0,6"/>
       </StackPanel>
      </StackPanel>

      <TextBlock Grid.Row="2" Text="Better care through smarter pharmacy tools." Foreground="#D9F0FF" FontStyle="Italic"/>
     </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="58,50">
     <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <StackPanel VerticalAlignment="Center" MaxWidth="390">
      <TextBlock Text="Welcome Back" FontSize="30" FontWeight="Bold"/>
      <TextBlock Text="Sign in to your PharmaCare POS account." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,28"/>

      <TextBlock Text="Username" FontWeight="SemiBold" Margin="3,0,0,5"/>
      <TextBox x:Name="UsernameBox" Text="admin" Height="43" Margin="0,0,0,16"/>

      <TextBlock Text="Password" FontWeight="SemiBold" Margin="3,0,0,5"/>
      <PasswordBox x:Name="PasswordBox" Password="Admin123!" Height="43" Margin="0,0,0,8"/>

      <Grid Margin="3,4,3,18">
       <CheckBox Content="Remember me" VerticalAlignment="Center"/>
       <TextBlock Text="Forgot password?" HorizontalAlignment="Right" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
      </Grid>

      <TextBlock x:Name="StatusText" Foreground="#C13D49" TextWrapping="Wrap" Margin="3,0,3,8"/>
      <Button x:Name="LoginButton" Content="Login" Style="{StaticResource PrimaryButton}" Height="45" Margin="0" Click="LoginButton_Click"/>
     </StackPanel>

     <StackPanel Grid.Row="1" HorizontalAlignment="Center">
      <TextBlock Text="Version 1.0.0 (Desktop)" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
      <TextBlock Text="API + SQLite offline mode" Foreground="#9AAABC" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>